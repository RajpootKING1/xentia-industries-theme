{% layout 'password' %}

<div class="password-page-container" style="width: 100%; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--space-8) var(--space-4); background: radial-gradient(circle at 50% 40%, rgba(212, 175, 55, 0.08) 0%, var(--color-bg-deep) 75%);">
  <div class="password-card" style="max-width: 520px; width: 100%; background: var(--color-surface); border: 1px solid var(--color-gold-hairline); border-radius: var(--radius-xl); padding: clamp(2rem, 5vw, 3.5rem); box-shadow: 0 24px 60px rgba(0,0,0,0.7), inset 0 1px 0 rgba(212, 175, 55, 0.2); text-align: center;">
    
    <!-- Emblem Logo -->
    <div style="margin-bottom: var(--space-6);">
      <img src="{{ 'logo-for-website.png' | asset_url }}" alt="Xentia Industries" width="200" height="85" style="max-height: 52px; width: auto; margin: 0 auto; display: block;">
    </div>

    <span class="badge-pill" style="margin-bottom: var(--space-4);">SIALKOT SURGICAL MANUFACTORY</span>

    <h1 style="font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; color: var(--color-steel-pure); line-height: 1.25; margin-bottom: var(--space-3);">
      Store Opening Soon
    </h1>

    <p style="font-size: var(--text-sm); color: var(--color-steel-medium); line-height: 1.65; margin-bottom: var(--space-6);">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        Precision surgical instruments crafted in Sialkot, Pakistan. We are currently calibrating our digital storefront for international hospital and distributor procurement.
      {%- endif -%}
    </p>

    <!-- Password Access Form -->
    {% form 'storefront_password', class: 'password-login-form' %}
      {%- if form.errors -%}
        <div class="alert alert-error" style="margin-bottom: var(--space-4); text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <label for="password" class="sr-only">Enter Store Password</label>
        <input 
          type="password" 
          name="password" 
          id="password" 
          class="form-input" 
          placeholder="Enter access password" 
          autocomplete="current-password"
          style="text-align: center; font-family: var(--font-accent); letter-spacing: 0.1em; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.15); color: var(--color-steel-pure); height: 50px; border-radius: var(--radius-md);"
          required
        >
        <button type="submit" class="btn btn-primary btn-block" style="height: 50px;">
          ENTER STORE
        </button>
      </div>
    {% endform %}

    <!-- Factory Contact Note -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: var(--text-xs); color: var(--color-steel-muted); line-height: 1.6;">
      <p style="margin-bottom: var(--space-2);">For urgent institutional hospital tenders or custom OEM blueprints:</p>
      <a href="https://wa.me/923459656454" target="_blank" rel="noopener noreferrer" style="color: var(--color-gold-bright); font-weight: 600; text-decoration: none;">
        Direct WhatsApp Desk: +92 345 9656454
      </a>
    </div>

    <!-- Store Owner Admin Login -->
    <div style="margin-top: var(--space-4); font-size: 11px; color: var(--color-steel-dark);">
      Are you the store owner? <a href="/admin" style="color: var(--color-steel-medium); text-decoration: underline;">Log in here</a>
    </div>

  </div>
</div>
