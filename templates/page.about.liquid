<article class="about-page">
  <!-- Hero Section -->
  <section class="about-hero text-center" style="padding: var(--space-16) var(--space-4); border-bottom: var(--border-hairline); background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 70%);">
    <div class="container" style="max-width: 840px;">
      <span class="badge-pill">SIALKOT METALLURGICAL HERITAGE</span>
      <h1 class="hero-title" style="font-size: var(--text-4xl); margin: var(--space-4) 0 var(--space-3) 0;">
        FORGING PRECISION SINCE 2008
      </h1>
      <p style="color: var(--color-steel-silver); font-size: var(--text-base); line-height: 1.8;">
        Headquartered in the global capital of surgical craftsmanship &ndash; Sialkot, Pakistan &ndash; Xentia Industries combines multi-generational master forging techniques with German DIN 1.4021 metallurgy and automated CNC 5-axis milling.
      </p>
    </div>
  </section>

  <!-- 4 Pillars of Metallurgy -->
  <section style="padding: var(--space-16) var(--space-4);">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-pill">SCIENTIFIC FOUNDATION</span>
        <h2 class="section-title">THE 4 PILLARS OF XENTIA METALLURGY</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); margin-top: var(--space-8);">
        <div class="glass-card" style="padding: var(--space-6); border: var(--border-hairline); border-radius: var(--radius-md); background: rgba(255,255,255,0.02);">
          <div style="color: var(--color-gold-base); font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-2);">01</div>
          <h3 style="color: var(--color-steel-white); font-size: var(--text-lg); margin-bottom: var(--space-2);">German DIN 1.4021 Alloys</h3>
          <p style="color: var(--color-steel-silver); font-size: var(--text-sm); line-height: 1.6;">High-carbon martensitic stainless steel with certified trace elements of manganese, carbon, and chromium for optimum sharpness retention.</p>
        </div>

        <div class="glass-card" style="padding: var(--space-6); border: var(--border-hairline); border-radius: var(--radius-md); background: rgba(255,255,255,0.02);">
          <div style="color: var(--color-gold-base); font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-2);">02</div>
          <h3 style="color: var(--color-steel-white); font-size: var(--text-lg); margin-bottom: var(--space-2);">Vacuum Tempering (54-58 HRC)</h3>
          <p style="color: var(--color-steel-silver); font-size: var(--text-sm); line-height: 1.6;">Computerized vacuum heat treatment prevents micro-fracturing and guarantees ductile spring temper in retractors and osteotomes.</p>
        </div>

        <div class="glass-card" style="padding: var(--space-6); border: var(--border-hairline); border-radius: var(--radius-md); background: rgba(255,255,255,0.02);">
          <div style="color: var(--color-gold-base); font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-2);">03</div>
          <h3 style="color: var(--color-steel-white); font-size: var(--text-lg); margin-bottom: var(--space-2);">ASTM F899 Passivation</h3>
          <p style="color: var(--color-steel-silver); font-size: var(--text-sm); line-height: 1.6;">Ultrasonic cleaning and chemical nitric/citric passivation build a non-porous chromium oxide film that withstands 1,000+ autoclave cycles.</p>
        </div>

        <div class="glass-card" style="padding: var(--space-6); border: var(--border-hairline); border-radius: var(--radius-md); background: rgba(255,255,255,0.02);">
          <div style="color: var(--color-gold-base); font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-2);">04</div>
          <h3 style="color: var(--color-steel-white); font-size: var(--text-lg); margin-bottom: var(--space-2);">40x Optical Inspection</h3>
          <p style="color: var(--color-steel-silver); font-size: var(--text-sm); line-height: 1.6;">Every jaw alignment, tungsten carbide brazing boundary, and scissor cutting clearance is inspected under 40x stereomicroscopes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Factory Metrics -->
  <section style="background: var(--color-bg-deep); padding: var(--space-12) var(--space-4); border-top: var(--border-hairline); border-bottom: var(--border-hairline);">
    <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-6); text-align: center;">
      <div>
        <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--color-gold-bright);">18+</div>
        <div style="font-size: var(--text-xs); color: var(--color-steel-muted); text-transform: uppercase; margin-top: 4px;">Years of Export Excellence</div>
      </div>
      <div>
        <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--color-gold-bright);">45+</div>
        <div style="font-size: var(--text-xs); color: var(--color-steel-muted); text-transform: uppercase; margin-top: 4px;">Destination Countries</div>
      </div>
      <div>
        <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--color-gold-bright);">120,000+</div>
        <div style="font-size: var(--text-xs); color: var(--color-steel-muted); text-transform: uppercase; margin-top: 4px;">Annual Instrument Capacity</div>
      </div>
      <div>
        <div style="font-size: var(--text-3xl); font-weight: 700; color: var(--color-gold-bright);">100%</div>
        <div style="font-size: var(--text-xs); color: var(--color-steel-muted); text-transform: uppercase; margin-top: 4px;">CE & ISO 13485:2016 Compliant</div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="text-center" style="padding: var(--space-16) var(--space-4);">
    <div class="container" style="max-width: 600px;">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-3xl); color: var(--color-steel-white); margin-bottom: var(--space-3);">PARTNER WITH THE FACTORY</h2>
      <p style="color: var(--color-steel-silver); font-size: var(--text-sm); margin-bottom: var(--space-6);">Schedule a virtual plant tour or discuss custom tooling requirements with our head metallurgical engineer.</p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/pages/wholesale-custom-orders" class="btn btn-primary btn-sm">START B2B QUOTE</a>
        <a href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}" class="btn btn-secondary btn-sm">CONTACT FACTORY DESK</a>
      </div>
    </div>
  </section>
</article>
