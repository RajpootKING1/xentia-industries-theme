{% # theme-check-disable UndefinedObject %}
<article class="policy-page-section" style="padding: var(--space-16) 0 var(--space-24) 0; min-height: 60vh;">
  <div class="container" style="max-width: 880px;">
    <!-- Breadcrumbs / Back Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb" style="margin-bottom: var(--space-8); font-size: var(--text-xs); color: var(--color-steel-muted);">
      <a href="{{ routes.root_url }}" style="color: var(--color-steel-silver); text-decoration: none;">Home</a>
      <span style="margin: 0 var(--space-2); color: var(--color-steel-dark);">&bull;</span>
      <span style="color: var(--color-gold-base);">{{ policy.title }}</span>
    </nav>

    <!-- Header -->
    <header class="section-header text-center" style="margin-bottom: var(--space-10);">
      <span class="badge-pill" style="margin-bottom: var(--space-3); display: inline-block;">OFFICIAL LEGAL POLICY</span>
      <h1 class="section-title" style="font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: var(--color-steel-white); margin: var(--space-3) 0;">
        {{ policy.title }}
      </h1>
      <div style="width: 60px; height: 2px; background: var(--color-gold-base); margin: var(--space-4) auto 0;"></div>
      <p style="font-size: var(--text-xs); color: var(--color-steel-muted); margin-top: var(--space-3); letter-spacing: var(--tracking-wider); text-transform: uppercase;">
        Xentia Industries &bull; Sialkot Factory Direct &bull; Institutional Compliance
      </p>
    </header>

    <!-- Policy Content Card -->
    <div class="glass-card" style="padding: clamp(1.5rem, 4vw, 2.5rem); border: var(--border-hairline); border-radius: var(--radius-lg); background: rgba(14, 15, 19, 0.95); box-shadow: var(--shadow-xl);">
      <div class="policy-content rte" style="color: var(--color-steel-silver); line-height: 1.85; font-size: var(--text-base);">
        {{ policy.body }}
      </div>
    </div>

    <!-- Related Policy Links -->
    <div class="policy-footer-nav" style="margin-top: var(--space-10); padding-top: var(--space-6); border-top: var(--border-hairline); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-4); font-size: var(--text-xs);">
      <a href="{{ routes.root_url }}" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
        &larr; Return to Storefront
      </a>
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-4); color: var(--color-steel-silver);">
        {%- if shop.refund_policy != blank and shop.refund_policy.url != policy.url -%}
          <a href="{{ shop.refund_policy.url }}" style="color: var(--color-steel-silver);">{{ shop.refund_policy.title }}</a>
        {%- endif -%}
        {%- if shop.shipping_policy != blank and shop.shipping_policy.url != policy.url -%}
          <a href="{{ shop.shipping_policy.url }}" style="color: var(--color-steel-silver);">{{ shop.shipping_policy.title }}</a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank and shop.terms_of_service.url != policy.url -%}
          <a href="{{ shop.terms_of_service.url }}" style="color: var(--color-steel-silver);">{{ shop.terms_of_service.title }}</a>
        {%- endif -%}
        {%- if shop.privacy_policy != blank and shop.privacy_policy.url != policy.url -%}
          <a href="{{ shop.privacy_policy.url }}" style="color: var(--color-steel-silver);">{{ shop.privacy_policy.title }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</article>
