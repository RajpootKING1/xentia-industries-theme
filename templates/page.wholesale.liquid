<section class="wholesale-page-section" style="padding: var(--space-12) 0 var(--space-20) 0;">
  <div class="container" style="max-width: 960px;">
    <div class="section-header text-center" style="margin-bottom: var(--space-10);">
      <span class="badge-pill">SIALKOT FACTORY DIRECT</span>
      <h1 class="section-title">CUSTOM SURGICAL OEM & WHOLESALE QUOTATION</h1>
      <p class="section-subtitle">
        Direct factory tooling, private label fiber laser marking, and volume container exports direct from our Sialkot manufacturing plant.
      </p>
    </div>

    <div class="glass-card" style="padding: var(--space-8); border: var(--border-medium); border-radius: var(--radius-lg); background: rgba(14, 15, 19, 0.95); box-shadow: var(--shadow-xl);">
      <form id="shopify-wholesale-form" action="/contact#contact_form" method="post" class="contact-inquiry-form">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="b2b-rfq,wholesale,oem">

        <h3 style="font-family: var(--font-heading); color: var(--color-steel-white); font-size: var(--text-xl); margin-bottom: var(--space-4); border-bottom: var(--border-hairline); padding-bottom: var(--space-2);">
          1. INSTITUTION & CONTACT DETAILS
        </h3>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name & Professional Designation <span class="required">*</span></label>
            <input type="text" name="contact[name]" required class="form-input" placeholder="Dr. Sarah Jenkins / Chief of Surgery">
          </div>
          <div class="form-group">
            <label class="form-label">Hospital / Procurement Email <span class="required">*</span></label>
            <input type="email" name="contact[email]" required class="form-input" placeholder="procurement@hospital-group.com">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Direct Phone / WhatsApp Desk</label>
            <input type="tel" name="contact[phone]" class="form-input" placeholder="+1 (555) 234-5678">
          </div>
          <div class="form-group">
            <label class="form-label">Hospital / Clinic / Distribution Enterprise <span class="required">*</span></label>
            <input type="text" name="contact[company]" required class="form-input" placeholder="Mercy Surgical Center">
          </div>
        </div>

        <h3 style="font-family: var(--font-heading); color: var(--color-steel-white); font-size: var(--text-xl); margin: var(--space-8) 0 var(--space-4) 0; border-bottom: var(--border-hairline); padding-bottom: var(--space-2);">
          2. INSTRUMENT REQUIREMENTS & SPECIFICATIONS
        </h3>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Primary Surgical Discipline</label>
            <select name="contact[discipline]" class="form-select">
              <option value="Plastic & Rhinoplasty">Plastic & Rhinoplasty</option>
              <option value="Hair Restoration FUE">Hair Restoration (FUE/FUT)</option>
              <option value="Dental Surgery">Dental & Maxillofacial</option>
              <option value="Orthopedic & Spine">Orthopedic & Spine</option>
              <option value="Microsurgery Ophthalmic">Microsurgery & Ophthalmic</option>
              <option value="Multi-Discipline Hospital Tender">Multi-Discipline Hospital Tender</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Estimated Order Quantity</label>
            <select name="contact[estimated_quantity]" class="form-select">
              <option value="Sample Evaluation (1-5 units)">Sample Evaluation (1-5 units)</option>
              <option value="Small Batch (25-100 units)">Small Batch (25-100 units)</option>
              <option value="Medium Volume (100-500 units)">Medium Volume (100-500 units)</option>
              <option value="Institutional Container (1,000+ units)">Institutional Container (1,000+ units)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Instrument SKUs, Custom Blueprints, or Special Requests <span class="required">*</span></label>
          <textarea name="contact[body]" rows="5" required class="form-textarea" placeholder="Specify instrument names (e.g. Aufricht retractor 16cm, Tebbetts needle holder TC 15cm), steel preferences, private label laser logo requirements, or custom modifications..."></textarea>
        </div>

        <div class="form-group" style="background: rgba(212,175,55,0.06); padding: var(--space-4); border-radius: var(--radius-sm); border: 1px dashed var(--color-gold-hairline);">
          <label style="display: flex; align-items: center; gap: 8px; font-size: var(--text-sm); color: var(--color-steel-silver); cursor: pointer;">
            <input type="checkbox" name="contact[request_sample]" value="yes" checked>
            <span>Request initial physical evaluation sample direct from Sialkot factory before mass production run.</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--space-6);">
          SUBMIT FORMAL B2B PRODUCTION REQUEST
        </button>
      </form>
    </div>
  </div>
</section>
