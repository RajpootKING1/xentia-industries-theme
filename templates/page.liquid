{%- assign page_handle_down = page.handle | downcase -%}
{%- assign page_title_down = page.title | downcase -%}
{%- if page_handle_down contains 'contact' or page_title_down contains 'contact' or page.template_suffix contains 'contact' or template.suffix contains 'contact' -%}
  <section class="contact-page-wrapper">
    {% section 'contact-section' %}
  </section>
{%- elsif page_handle_down contains 'about' or page_title_down contains 'about' or page.template_suffix contains 'about' or template.suffix contains 'about' -%}
  <section class="about-page-wrapper">
    {% render 'about-content' %}
  </section>
{%- elsif page_handle_down contains 'product' or page_handle_down contains 'categories' or page_handle_down contains 'category' or page_handle_down contains 'shop' or page_handle_down contains 'catalog' or page_title_down contains 'product' or page_title_down contains 'categories' or page_title_down contains 'category' or page_title_down contains 'shop' or page_title_down contains 'catalog' or page.template_suffix contains 'product' or template.suffix contains 'product' or page.template_suffix contains 'categor' or template.suffix contains 'categor' or page.template_suffix contains 'catalog' or template.suffix contains 'catalog' -%}
  <div class="products-catalog-page-wrapper">
    {% section 'catalog-categories' %}
  </div>
{%- elsif page_handle_down contains 'faq' or page_title_down contains 'faq' or page.template_suffix contains 'faq' or template.suffix contains 'faq' -%}
  <section class="faq-page-wrapper">
    {% render 'faq-content' %}
  </section>
{%- else -%}
  {% section 'main-page' %}
{%- endif -%}
