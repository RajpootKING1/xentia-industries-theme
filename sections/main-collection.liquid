{%- comment -%}
  Xentia Industries - Master Products & Category Collections
  Dual Mode Architecture:
  1. Master Catalog Showcase (collection.handle == 'all' or blank):
     Renders full 18 clinical disciplines showcase with 5-card horizontal rows and placeholders
  2. Dedicated Discipline View (collection.handle != 'all'):
     Displays all products for that specific category in full responsive grid with pagination
{%- endcomment -%}

{%- assign is_all_catalog = false -%}
{%- if collection == blank or collection.handle == blank or collection.handle == 'all' or template.name == 'list-collections' or template.name == 'page' -%}
  {%- assign is_all_catalog = true -%}
{%- endif -%}

{%- if is_all_catalog -%}
  {% render 'catalog-categories-content' %}
{%- else -%}
  <!-- ========================================================================
       MODE 2: SPECIFIC CATEGORY COLLECTION PAGE (FULL CATALOG GRID)
       ======================================================================== -->
  <section class="section collection-page-section specific-category-page">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <nav class="breadcrumb-trail" aria-label="Breadcrumb Navigation" style="margin-bottom: var(--space-6);">
        <ol style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0; margin: 0; color: var(--color-steel-muted);">
          <li><a href="{{ routes.root_url }}" style="color: var(--color-steel-silver);">Home</a></li>
          <li>&rsaquo;</li>
          <li><a href="{{ routes.all_products_collection_url }}" style="color: var(--color-steel-silver);">All Products</a></li>
          <li>&rsaquo;</li>
          <li style="color: var(--color-gold-base);">{{ collection.title }}</li>
        </ol>
      </nav>

      <!-- Category Header -->
      <div class="section-header text-center" style="max-width: 860px; margin: 0 auto var(--space-8) auto;">
        <span class="badge-pill">SIALKOT FACTORY COLLECTION</span>
        <h1 class="section-title" style="margin-top: var(--space-3); margin-bottom: var(--space-3);">
          {{ collection.title }}
        </h1>
        <p class="section-subtitle">
          {{ collection.description | default: 'Precision medical instruments forged from German DIN 1.4021 stainless steel and Japanese cobalt alloys. Full clinical evaluation series.' }}
        </p>
        <div style="margin-top: var(--space-4);">
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary btn-sm">
            &larr; BACK TO ALL CATEGORIES
          </a>
        </div>
      </div>

      <!-- Full Products Grid with Pagination -->
      <div class="product-grid" style="margin-top: var(--space-8);">
        {%- paginate collection.products by 48 -%}
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            <!-- Empty Category View with 5 Placeholders and B2B RFQ CTA -->
            <div class="empty-category-showcase" style="grid-column: 1 / -1; width: 100%;">
              <div class="catalog-empty text-center" style="padding: var(--space-8) var(--space-4); margin-bottom: var(--space-8); background: rgba(255,255,255,0.02); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: var(--radius-md);">
                <span class="badge-pill" style="margin-bottom: var(--space-2);">CUSTOM PRODUCTION READY</span>
                <p style="color: var(--color-steel-white); font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-2);">
                  Active catalog listings for {{ collection.title }} are currently being published from the Sialkot factory floor.
                </p>
                <p style="color: var(--color-steel-medium); font-size: var(--text-sm); max-width: 620px; margin: 0 auto var(--space-4) auto;">
                  We forge complete custom sets and precision OEM instruments to your exact dimensional blueprints and DIN 1.4021 metallurgical specifications.
                </p>
                <a href="/pages/wholesale-custom-orders?specialty={{ collection.handle }}" class="btn btn-primary btn-sm">
                  REQUEST CUSTOM OEM PRODUCTION RUN
                </a>
              </div>

              <!-- 5 Placeholders for Empty Category -->
              <div class="category-products-row-container">
                <div class="category-products-row">
                  {% for i in (1..5) %}
                    {% render 'product-card-placeholder', category_name: collection.title, category_handle: collection.handle, index: i %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {%- endfor -%}

          {%- if paginate.pages > 1 -%}
            <div class="pagination-wrap" style="grid-column: 1 / -1; text-align: center; margin-top: var(--space-10);">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection Grid & Showcase",
  "settings": []
}
{% endschema %}
