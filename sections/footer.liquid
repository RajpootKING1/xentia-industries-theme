<footer style="background-color: var(--color-bg-deep); border-top: var(--border-medium); padding: var(--space-16) 0 var(--space-8) 0; font-size: var(--text-sm);" role="contentinfo">
  <div class="container">
    <div class="grid-4" style="margin-bottom: var(--space-12);">
      
      <!-- Column 1: Company Info & Social Handles -->
      <div>
        <a href="{{ routes.root_url }}" aria-label="Xentia Industries">
          <img src="{{ 'logo-for-website.png' | asset_url }}" alt="Xentia Industries" width="160" height="68" style="height: 42px; width: auto; margin-bottom: var(--space-4);">
        </a>
        <p style="font-size: var(--text-xs); color: var(--color-steel-medium); line-height: var(--leading-relaxed); margin-bottom: var(--space-4);">
          Premier manufacturer and international exporter of professional surgical, dental, orthopedic, and veterinary instruments forged from German DIN 1.4021 Stainless Steel.
        </p>
        <p style="font-size: var(--text-xs); color: var(--color-steel-silver); margin-bottom: var(--space-4);">
          <strong>{{ settings.factory_address | default: 'Shahab Pura Road / Ugoki Road, Small Industries Estate, Sialkot 51310, Punjab, Pakistan' }}</strong>
        </p>
        <p style="font-size: var(--text-xs); color: var(--color-steel-medium); margin-bottom: var(--space-4);">
          Desk: <a href="tel:{{ settings.contact_phone_1 | default: '+923459656454' }}" style="color: var(--color-gold-base);">{{ settings.contact_phone_1 | default: '+92 345 9656454' }}</a> &bull;
          Email: <a href="mailto:{{ settings.contact_email | default: 'info@xentiaindustries.com' }}" style="color: var(--color-gold-base);">{{ settings.contact_email | default: 'info@xentiaindustries.com' }}</a>
        </p>
        
        <!-- Social Icons -->
        {% render 'social-icons' %}
      </div>

      <!-- Column 2: Clinical Disciplines & Navigation -->
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">PAGES &amp; CATALOG</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="{{ routes.all_products_collection_url }}" style="color: var(--color-steel-silver);">Browse All 50+ Products</a></li>
          <li><a href="{{ routes.root_url }}#surgical-sets" style="color: var(--color-steel-silver);">Complete Surgical Sets (19 Sets)</a></li>
          <li><a href="/pages/wholesale-custom-orders" style="color: var(--color-steel-silver);">B2B Custom Quotation Portal</a></li>
          <li><a href="/pages/about" style="color: var(--color-steel-silver);">About Xentia Industries</a></li>
          <li><a href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}" style="color: var(--color-steel-silver);">Contact Sialkot Factory</a></li>
          <li><a href="{{ routes.account_url }}" style="color: var(--color-steel-silver);">Customer Account Portal</a></li>
        </ul>
      </div>

      <!-- Column 3: B2B Solutions -->
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">B2B SOLUTIONS</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="/pages/wholesale-custom-orders" style="color: var(--color-steel-silver);">Wholesale &amp; Custom Orders</a></li>
          <li><a href="{{ routes.root_url }}#surgical-sets" style="color: var(--color-steel-silver);">Modular DIN Sterilization Trays</a></li>
          <li><a href="/pages/wholesale-custom-orders" style="color: var(--color-steel-silver);">Custom OEM &amp; Private Labeling</a></li>
          <li><a href="/pages/wholesale-custom-orders" style="color: var(--color-steel-silver);">MOPA Laser Logo Engraving</a></li>
          <li><a href="/pages/faq" style="color: var(--color-steel-silver);">FAQ &amp; Procurement Guide</a></li>
        </ul>
      </div>

      <!-- Column 4: Institutional Policies -->
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">INSTITUTIONAL POLICIES</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="/pages/policies#warranty" style="color: var(--color-steel-silver);">Return &amp; Replacement Warranty</a></li>
          <li><a href="/pages/policies#shipping" style="color: var(--color-steel-silver);">Shipping Policy (EXW/FOB/DDP)</a></li>
          <li><a href="/pages/policies#terms" style="color: var(--color-steel-silver);">Terms &amp; Conditions of Supply</a></li>
          <li><a href="/pages/policies#privacy" style="color: var(--color-steel-silver);">Privacy &amp; GDPR Compliance</a></li>
          <li><a href="/pages/faq" style="color: var(--color-steel-silver);">Procurement FAQ</a></li>
        </ul>
      </div>
    </div>

    <hr class="divider" style="margin: var(--space-8) 0 var(--space-6) 0;">

    <div class="flex items-center justify-between flex-wrap gap-4" style="font-size: var(--text-xs); color: var(--color-steel-muted);">
      <p>&copy; {{ 'now' | date: "%Y" }} Xentia Industries. All rights reserved. Sialkot, Punjab, Pakistan.</p>
      <div class="flex items-center gap-4">
        <span>ISO 13485:2016</span>
        <span>&bull;</span>
        <span>CE DIRECTIVE 93/42/EEC</span>
        <span>&bull;</span>
        <span>FDA Registered</span>
        <span>&bull;</span>
        <span>ASTM F899 Compliant</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
