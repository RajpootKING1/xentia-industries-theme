<footer class="footer-root">
  <div class="container footer-grid">
    <!-- Col 1: Brand & Sialkot HQ -->
    <div class="footer-col">
      <img src="{{ 'logo_xentia.png' | asset_url }}" alt="Xentia Industries" width="160" height="40" class="footer-logo">
      <p class="footer-text">
        Precision surgical instruments engineered from German DIN 1.4021 & Japanese cobalt stainless steel. Direct factory manufacturing, custom OEM/ODM tooling, and global hospital export since 2008.
      </p>
      <div class="footer-contact-details">
        <p><strong>Factory:</strong> {{ settings.factory_address | default: 'Ugoki Road, Small Industrial Estate, Sialkot 51310, Punjab, Pakistan' }}</p>
        <p><strong>Desk:</strong> {{ settings.contact_phone_1 | default: '+92 345 9656454' }} / {{ settings.contact_phone_2 | default: '+92 349 7400818' }}</p>
        <p><strong>Email:</strong> {{ settings.contact_email | default: 'info@xentiaindustries.com' }}</p>
      </div>
      {% render 'social-icons', class: 'footer-socials' %}
    </div>

    <!-- Col 2: Surgical Specialties -->
    <div class="footer-col">
      <h3 class="footer-heading">SURGICAL DISCIPLINES</h3>
      <ul class="footer-links">
        <li><a href="/collections/all?specialty=rhinoplasty">Plastic & Rhinoplasty Instruments</a></li>
        <li><a href="/collections/all?specialty=hair-restoration">FUE & FUT Hair Restoration</a></li>
        <li><a href="/collections/all?specialty=dental">Dental & Maxillofacial Extraction</a></li>
        <li><a href="/collections/all?specialty=orthopedic">Orthopedic Retractors & Elevators</a></li>
        <li><a href="/collections/all?specialty=ophthalmic">Microsurgical Ophthalmic Tools</a></li>
        <li><a href="/collections/all?specialty=tc-inlays">Tungsten Carbide (TC) Inlays</a></li>
      </ul>
    </div>

    <!-- Col 3: Factory Services -->
    <div class="footer-col">
      <h3 class="footer-heading">B2B SERVICES</h3>
      <ul class="footer-links">
        <li><a href="/pages/wholesale-custom-orders">Custom OEM / ODM Manufacturing</a></li>
        <li><a href="/#surgical-sets">Custom Modular Surgical Trays</a></li>
        <li><a href="/pages/about#metallurgy">German Metallurgy & Passivation</a></li>
        <li><a href="/pages/wholesale-custom-orders">Private Labeling & Fiber Laser Marking</a></li>
        <li><a href="/pages/wholesale-custom-orders">Cleanroom Packaging & Sterile Pouching</a></li>
        <li><a href="/pages/faq">Bulk Institutional Procurement</a></li>
      </ul>
    </div>

    <!-- Col 4: Quality & Compliance -->
    <div class="footer-col">
      <h3 class="footer-heading">COMPLIANCE & LEGAL</h3>
      <ul class="footer-links">
        <li><a href="/pages/policies#warranty">Lifetime Metallurgical Warranty</a></li>
        <li><a href="/pages/policies#shipping">Incoterms 2020 Export Protocols</a></li>
        <li><a href="/pages/policies#terms">Institutional Terms of Service</a></li>
        <li><a href="/pages/policies#privacy">GDPR & Medical Data Privacy</a></li>
        <li><a href="/pages/faq">Procurement FAQ</a></li>
        <li><a href="/pages/contact">Factory Visit Request</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {{ 'now' | date: "%Y" }} Xentia Industries. All rights reserved. Sialkot, Pakistan.</p>
      <div class="footer-bottom-badges">
        <span>ISO 13485:2016</span>
        <span>CE DIRECTIVE 93/42/EEC</span>
        <span>FDA REGISTERED</span>
        <span>ASTM F899 COMPLIANT</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
