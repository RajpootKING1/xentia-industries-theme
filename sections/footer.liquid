<footer style="background-color: var(--color-bg-deep); border-top: var(--border-medium); padding: var(--space-16) 0 var(--space-8) 0; font-size: var(--text-sm);" role="contentinfo">
  <div class="container">
    <div class="grid-4" style="margin-bottom: var(--space-12);">
      
      <!-- Column 1: Company Info & Social Handles -->
      <div>
        <a href="{{ routes.root_url }}" aria-label="Xentia Industries">
          <img src="{{ 'logo-for-website.png' | asset_url }}" alt="Xentia Industries" width="160" height="68" style="height: 42px; width: auto; margin-bottom: var(--space-4);">
        </a>
        <p style="font-size: var(--text-xs); color: var(--color-steel-medium); line-height: var(--leading-relaxed); margin-bottom: var(--space-4);">
          Premier manufacturer and international exporter of professional surgical, dental, orthopedic, ENT, Beauty and Plastic & Cosmtic Surgery instruments forged from German DIN 1.4021 Stainless Steel.
        </p>
        <p style="font-size: var(--text-xs); color: var(--color-steel-silver); margin-bottom: var(--space-4);">
          <strong>{{ settings.factory_address | default: 'Shahab Pura Road / Ugoki Road, Small Industries Estate, Sialkot 51310, Punjab, Pakistan' }}</strong>
        </p>
        <p style="font-size: var(--text-xs); color: var(--color-steel-medium); margin-bottom: var(--space-4);">
          Desk: <a href="tel:{{ settings.contact_phone_1 | default: '+923497400818' }}" style="color: var(--color-gold-base);">{{ settings.contact_phone_1 | default: '+92 349 7400818' }}</a> &bull;
          Email: <a href="mailto:{{ settings.contact_email | default: 'info@xentiaindustries.com' }}" style="color: var(--color-gold-base);">{{ settings.contact_email | default: 'info@xentiaindustries.com' }}</a>
        </p>
        
        <!-- Social Icons -->
        {% render 'social-icons' %}
      </div>

      <!-- Column 2: Clinical Disciplines & Navigation -->
      {%- assign f_path = request.path | default: '' | downcase -%}
      {%- assign f_handle = page.handle | default: '' | downcase -%}
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">PAGES &amp; CATALOG</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="{{ pages['products-categories'].url | default: pages['products'].url | default: routes.all_products_collection_url }}" {% if f_handle contains 'product' or f_handle contains 'categor' or f_path contains 'products-categories' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Products &amp; Categories</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" {% if f_path == routes.all_products_collection_url %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Browse All Products</a></li>
          <li><a href="{{ pages['surgical-sets'].url | default: '/pages/surgical-sets' }}" {% if f_handle contains 'surgical-set' or f_path contains 'surgical-set' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Surgical Sets</a></li>
          <li><a href="{{ pages['wholesale-custom-orders'].url | default: pages['wholesale'].url | default: '/pages/wholesale-custom-orders' }}" {% if f_handle contains 'wholesale' or f_handle contains 'custom-order' or f_path contains 'wholesale' or f_path contains 'custom-order' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Wholesale &amp; Custom Orders</a></li>
          <li><a href="{{ pages['about-us'].url | default: pages['about'].url | default: '/pages/about-us' }}" {% if f_handle contains 'about' or f_path contains 'about' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>About Us</a></li>
          <li><a href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}" {% if f_handle contains 'contact' or f_path contains 'contact' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Contact Us</a></li>
          <li><a href="{{ routes.account_url }}" {% if f_path contains 'account' or f_path contains 'login' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Customer Account</a></li>
        </ul>
      </div>

      <!-- Column 3: B2B Solutions -->
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">B2B SOLUTIONS</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="{{ pages['wholesale-custom-orders'].url | default: pages['wholesale'].url | default: '/pages/wholesale-custom-orders' }}" {% if f_handle contains 'wholesale' or f_path contains 'wholesale' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Wholesale &amp; Custom Orders</a></li>
          <li><a href="{{ pages['surgical-sets'].url | default: '/pages/surgical-sets' }}#tray-configurator" style="color: var(--color-steel-silver);">Modular DIN Sterilization Trays</a></li>
          <li><a href="{{ pages['wholesale-custom-orders'].url | default: pages['wholesale'].url | default: '/pages/wholesale-custom-orders' }}" style="color: var(--color-steel-silver);">Custom OEM &amp; Private Labeling</a></li>
          <li><a href="{{ pages['wholesale-custom-orders'].url | default: pages['wholesale'].url | default: '/pages/wholesale-custom-orders' }}" style="color: var(--color-steel-silver);">MOPA Laser Logo Engraving</a></li>
          <li><a href="{{ pages['faqs'].url | default: pages['faq'].url | default: '/pages/faqs' }}" {% if f_handle contains 'faq' or f_path contains 'faq' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>FAQs</a></li>
        </ul>
      </div>

      <!-- Column 4: Institutional Policies -->
      <div>
        <h4 style="font-size: var(--text-sm); font-family: var(--font-accent); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-gold-base); margin-bottom: var(--space-4);">INSTITUTIONAL POLICIES</h4>
        <ul style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-xs); list-style: none; padding: 0;">
          <li><a href="{{ pages['policies'].url | default: '/pages/policies' }}" {% if f_handle contains 'polic' or f_path contains 'polic' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>Refund, Return &amp; Cancellation Policy</a></li>
          <li><a href="{{ pages['policies'].url | default: '/pages/policies' }}#shipping" style="color: var(--color-steel-silver);">Shipping Policy (EXW/FOB/DDP)</a></li>
          <li><a href="{{ pages['policies'].url | default: '/pages/policies' }}#terms" style="color: var(--color-steel-silver);">Terms &amp; Conditions of Supply</a></li>
          <li><a href="{{ pages['policies'].url | default: '/pages/policies' }}#privacy" style="color: var(--color-steel-silver);">Privacy Policy &amp; GDPR</a></li>
          <li><a href="{{ pages['policies'].url | default: '/pages/policies' }}#compliance" style="color: var(--color-steel-silver);">Quality &amp; Regulatory Compliance</a></li>
          <li><a href="{{ pages['faqs'].url | default: pages['faq'].url | default: '/pages/faqs' }}" {% if f_handle contains 'faq' or f_path contains 'faq' %}style="color: var(--color-gold-base); font-weight: 700;"{% else %}style="color: var(--color-steel-silver);"{% endif %}>FAQs</a></li>
        </ul>
      </div>
    </div>

    <hr class="divider" style="margin: var(--space-8) 0 var(--space-6) 0;">

    <div class="flex items-center justify-between flex-wrap gap-4" style="font-size: var(--text-xs); color: var(--color-steel-muted);">
      <p>&copy; {{ 'now' | date: "%Y" }} Xentia Industries. All rights reserved. Sialkot, Punjab, Pakistan.</p>
      <div class="flex items-center gap-4">
        <span>ISO 13485:2016</span>
        <span>&bull;</span>
        <span>CE DIRECTIVE 93/42/EEC</span>
        <span>&bull;</span>
        <span>FDA Registered</span>
        <span>&bull;</span>
        <span>ASTM F899 Compliant</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
