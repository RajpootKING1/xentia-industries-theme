<header class="header-root">
  <!-- Top Utility Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-item">
        <span class="pulse-dot"></span>
        <span class="text-white font-medium">SIALKOT FACTORY DIRECT</span>
        <span class="text-steel-dim font-mono">| CE & ISO 13485:2016 CERTIFIED</span>
      </div>
      <div class="top-bar-item">
        <a href="tel:{{ settings.contact_phone_1 | default: '+923459656454' }}" class="text-white hover:text-gold transition">
          <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.27c1.12.45 2.33.69 3.58.69a1 1 0 011 1v3.49a1 1 0 01-1 1A17.92 17.92 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.24 2.45.69 3.58a1 1 0 01-.27 1.11l-2.3 2.1z"/></svg>
          {{ settings.contact_phone_1 | default: '+92 345 9656454' }}
        </a>
        <span class="text-steel-dim font-mono">|</span>
        <a href="mailto:{{ settings.contact_email | default: 'info@xentiaindustries.com' }}" class="text-white hover:text-gold transition">
          {{ settings.contact_email | default: 'info@xentiaindustries.com' }}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="main-nav">
    <div class="container nav-container">
      <!-- Brand Logo -->
      <a href="/" class="brand-link" aria-label="Xentia Industries Home">
        <img 
          src="{{ 'logo_xentia.png' | asset_url }}" 
          alt="Xentia Industries" 
          width="180" 
          height="44" 
          class="brand-logo"
        >
      </a>

      <!-- Desktop Nav Links -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <a href="/collections/all" class="nav-link">CATALOG</a>
        <a href="/#surgical-sets" class="nav-link">SURGICAL SETS</a>
        <a href="/#oem-showcase" class="nav-link">CUSTOM OEM</a>
        <a href="/pages/about" class="nav-link">ABOUT FACTORY</a>
        <a href="/pages/faq" class="nav-link">FAQ</a>
        <a href="/pages/contact" class="nav-link">CONTACT</a>
      </nav>

      <!-- Nav Actions -->
      <div class="nav-actions">
        <a href="/pages/wholesale-custom-orders" class="btn btn-primary btn-sm nav-cta-btn">B2B QUOTE</a>
        <a href="/account" class="nav-icon-btn" aria-label="Customer Account">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </a>
        <a href="/cart" class="nav-icon-btn js-cart-trigger" id="open-cart-btn" aria-label="Shopping Cart">
          <div style="position: relative;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <span class="cart-badge" id="header-cart-count" style="display: none;">0</span>
          </div>
        </a>
        <button type="button" class="mobile-menu-toggle" id="mobile-menu-open-btn" aria-label="Open Navigation Menu">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="mobile-drawer" style="display: none;">
    <div class="mobile-drawer-header">
      <img src="{{ 'logo_xentia.png' | asset_url }}" alt="Xentia Industries" width="140" height="34">
      <button type="button" id="mobile-menu-close-btn" class="drawer-close-btn" aria-label="Close Menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="mobile-drawer-body">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/collections/all" class="mobile-nav-link">Instruments Catalog</a>
      <a href="/#surgical-sets" class="mobile-nav-link">Surgical Sets & Trays</a>
      <a href="/#oem-showcase" class="mobile-nav-link">Custom OEM Manufacturing</a>
      <a href="/pages/wholesale-custom-orders" class="mobile-nav-link text-gold">Request B2B Quotation</a>
      <a href="/pages/about" class="mobile-nav-link">Sialkot Metallurgy & Factory</a>
      <a href="/pages/contact" class="mobile-nav-link">Contact Factory Team</a>
      <a href="/pages/faq" class="mobile-nav-link">Procurement FAQ</a>
      <a href="/pages/policies" class="mobile-nav-link">Warranty & Compliance</a>
      <a href="/account" class="mobile-nav-link">Customer / Hospital Account</a>

      <div class="mobile-drawer-social">
        {% render 'social-icons' %}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
