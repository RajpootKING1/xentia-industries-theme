<!-- ========================================================================
     1. Global Announcement / Utility Strip
     ======================================================================== -->
<aside class="utility-strip" style="background-color: var(--color-bg-deep); border-bottom: 1px solid rgba(212, 175, 55, 0.22); font-size: var(--text-xs); padding: var(--space-2) 0;" aria-label="Global Announcements">
  <div class="container flex items-center justify-between">
    <div class="flex items-center gap-4">
      <span class="badge badge-gold" style="font-size: 10px;">Sialkot Manufacturer</span>
      <span class="hide-mobile" style="color: var(--color-steel-medium);">Worldwide Export Delivery (EXW, FOB, CIF, DAP, DDP)</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="{{ settings.social_whatsapp_url | default: 'https://wa.me/923497400818' }}" target="_blank" rel="noopener noreferrer" style="color: var(--color-steel-silver); display: inline-flex; align-items: center; gap: 4px;">
        <span>WhatsApp:</span> <strong style="color: var(--color-gold-base);">{{ settings.contact_phone_1 | default: '+92 349 7400818' }}</strong>
      </a>
      <span class="hide-mobile" style="color: var(--color-steel-dark);">|</span>
      <a href="mailto:{{ settings.contact_email | default: 'info@xentiaindustries.com' }}" class="hide-mobile" style="color: var(--color-steel-medium);">{{ settings.contact_email | default: 'info@xentiaindustries.com' }}</a>
    </div>
  </div>
</aside>

<!-- ========================================================================
     2. Architectural Header with 4-Wing Specialty Mega-Menu
     ======================================================================== -->
<header class="site-header" style="background: rgba(10, 10, 12, 0.94); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid rgba(212, 175, 55, 0.32); position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.5);" role="banner">
  <div class="container flex items-center justify-between" style="height: 76px;">
    
    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-3" aria-label="Xentia Industries Homepage">
      <img src="{{ 'logo-for-website.png' | asset_url }}" alt="Xentia Industries Logo" width="180" height="77" style="height: 48px; width: auto; object-fit: contain;">
    </a>

    <!-- Desktop Main Navigation with 4-Wing Mega-Menu -->
    <nav class="hide-mobile" aria-label="Main Navigation">
      <ul class="flex items-center gap-6" style="font-family: var(--font-display); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); margin: 0; padding: 0; list-style: none;">
        <li><a href="{{ routes.root_url }}" style="color: var(--color-gold-base);">HOME</a></li>
        
        <!-- Products Link with Interactive 4-Wing Mega-Menu -->
        <li class="nav-item-has-mega">
          <button 
            type="button" 
            id="nav-products-trigger" 
            class="flex items-center gap-1" 
            style="background: none; border: none; font-family: inherit; font-size: inherit; font-weight: inherit; letter-spacing: inherit; color: var(--color-steel-silver); cursor: pointer; padding: 8px 0; text-transform: uppercase;"
            aria-haspopup="true" 
            aria-expanded="false" 
            aria-controls="products-mega-menu"
          >
            <span>PRODUCTS</span>
            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="transition: transform var(--transition-fast);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- 4-Wing Clinical Mega-Menu Dropdown -->
          <div id="products-mega-menu" class="mega-menu" role="region" aria-label="Surgical Disciplines Catalog">
            <div class="mega-menu-grid">
              
              <!-- Wing 1: General & Reconstructive -->
              <div class="mega-wing">
                <div class="mega-wing-title">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>General & Reconstructive</span>
                </div>
                <ul class="mega-wing-list">
                  <li><a href="{{ routes.all_products_collection_url }}">Scalpels & Precision Handles</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Metzenbaum & Mayo Dissecting Scissors</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Tungsten Carbide Needle Holders</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Hemostatic Forceps & Clamps</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Atraumatic Tissue Forceps</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Self-Retaining Retractors</a></li>
                </ul>
              </div>

              <!-- Wing 2: Plastic, Cosmetic & Aesthetic -->
              <div class="mega-wing">
                <div class="mega-wing-title">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                  <span>Plastic & Aesthetic Surgery</span>
                </div>
                <ul class="mega-wing-list">
                  <li><a href="{{ routes.all_products_collection_url }}">Rhinoplasty Chisels & Osteotomes</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Aufricht & Cottle Retractors</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Liposuction Cannulas (Luer / Power)</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Breast Retractors with Fiber Optic Light</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Facelift Scissors & Dissectors</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">FUE Hair Transplant Punches & Forceps</a></li>
                </ul>
              </div>

              <!-- Wing 3: Orthopedic & Spine -->
              <div class="mega-wing">
                <div class="mega-wing-title">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                  <span>Orthopedic & Spine Surgery</span>
                </div>
                <ul class="mega-wing-list">
                  <li><a href="{{ routes.all_products_collection_url }}">Bone Holding Clamps & Forceps</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Liston & Stille Bone Cutters</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Kerrison Cervical / Lumbar Rongeurs</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Hohmann & Beckman Retractors</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Orthopedic Mallets & Gouges</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Periosteal Elevators & Curettes</a></li>
                </ul>
              </div>

              <!-- Wing 4: Specialized Disciplines & Sets -->
              <div class="mega-wing">
                <div class="mega-wing-title">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                  <span>Specialized & Turnkey Sets</span>
                </div>
                <ul class="mega-wing-list">
                  <li><a href="{{ routes.root_url }}#surgical-sets">19 Turnkey Procedural Trays</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Dental & Oral Maxillofacial Instruments</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Veterinary Surgical Instrumentation</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Japanese 440C Convex Hairdressing Shears</a></li>
                  <li><a href="/pages/wholesale-custom-orders">Custom OEM / ODM Blueprint Tooling</a></li>
                  <li><a href="/pages/wholesale-custom-orders">DIN Sterilization Container Systems</a></li>
                </ul>
              </div>

            </div>
          </div>
        </li>

        <li><a href="{{ routes.root_url }}#surgical-sets" style="color: var(--color-steel-silver);">SETS (19)</a></li>
        <li><a href="{{ routes.root_url }}#oem-showcase" style="color: var(--color-steel-silver);">CUSTOM OEM</a></li>
        <li><a href="{{ pages['about-us'].url | default: pages['about'].url | default: '/pages/about-us' }}" style="color: var(--color-steel-silver);">ABOUT</a></li>
        <li><a href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}" style="color: var(--color-steel-silver);">CONTACT</a></li>
        <li><a href="/pages/faq" style="color: var(--color-steel-silver);">FAQ</a></li>
      </ul>
    </nav>

    <!-- Header Quick Action Elements -->
    <div class="flex items-center gap-3">
      <!-- Direct Live Cart Trigger -->
      <a href="{{ routes.cart_url }}" id="open-cart-btn" class="btn btn-secondary btn-sm" aria-label="View Shopping Cart">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span class="hide-mobile">CART</span>
        <span id="header-cart-count" class="cart-count-badge" style="display: none;">0</span>
      </a>

      <!-- Primary B2B RFQ CTA Button -->
      <a href="/pages/wholesale-custom-orders" class="btn btn-primary btn-sm hide-mobile">
        REQUEST QUOTE
      </a>

      <!-- Mobile Hamburger Menu Button -->
      <button id="mobile-menu-toggle" class="header-icon-btn hide-desktop" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- ========================================================================
     3. Mobile Slide-Out Navigation Drawer
     ======================================================================== -->
<div id="mobile-drawer-backdrop" class="mobile-drawer-backdrop" aria-hidden="true"></div>
<nav id="mobile-nav-drawer" class="mobile-nav-drawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true">
  <div>
    <div class="mobile-drawer-header">
      <a href="{{ routes.root_url }}" aria-label="Xentia Industries">
        <img src="{{ 'logo-for-website.png' | asset_url }}" alt="Xentia Industries" width="160" height="68" style="height: 38px; width: auto;">
      </a>
      <button id="mobile-drawer-close" class="modal-close-btn" aria-label="Close navigation menu" style="position: static; width: 32px; height: 32px;">
        &times;
      </button>
    </div>

    <ul class="mobile-nav-links">
      <li><a href="{{ routes.root_url }}" class="mobile-nav-link">HOME</a></li>
      <li><a href="{{ routes.all_products_collection_url }}" class="mobile-nav-link">CATALOG (50+ TOOLS)</a></li>
      <li><a href="{{ routes.root_url }}#surgical-sets" class="mobile-nav-link">SURGICAL SETS (19)</a></li>
      <li><a href="/pages/wholesale-custom-orders" class="mobile-nav-link" style="color: var(--color-gold-base);">CUSTOM OEM / RFQ</a></li>
      <li><a href="{{ pages['about-us'].url | default: pages['about'].url | default: '/pages/about-us' }}" class="mobile-nav-link">ABOUT XENTIA</a></li>
      <li><a href="{{ pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' }}" class="mobile-nav-link">CONTACT FACTORY</a></li>
      <li><a href="{{ routes.account_url }}" class="mobile-nav-link">CUSTOMER ACCOUNT</a></li>
      <li><a href="/pages/faq" class="mobile-nav-link">PROCUREMENT FAQ</a></li>
      <li><a href="/pages/policies" class="mobile-nav-link">WARRANTY & POLICIES</a></li>
    </ul>
  </div>

  <div class="mobile-drawer-footer">
    <a href="/pages/wholesale-custom-orders" class="btn btn-primary btn-block" style="margin-bottom: var(--space-3);">
      REQUEST CUSTOM QUOTE
    </a>

    <!-- Social Media Icons in Drawer -->
    <div style="display: flex; justify-content: center; margin-bottom: var(--space-4);">
      {% render 'social-icons' %}
    </div>

    <div style="font-size: 11px; color: var(--color-steel-muted); text-align: center;">
      <p style="margin: 0 0 4px 0;">Ugoki Road / Shahab Pura Road, Small Industries Estate</p>
      <p style="margin: 0;">Sialkot 51310, Punjab, Pakistan</p>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": []
}
{% endschema %}
