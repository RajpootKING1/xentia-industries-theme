{%- if settings.enable_mobile_app_bar -%}
<nav class="mobile-bottom-app-bar" aria-label="Mobile Storefront Navigation">
  <a href="{{ routes.root_url }}" class="mobile-nav-item mobile-app-nav-item {% if request.path == routes.root_url %}active is-active{% endif %}" aria-label="Storefront Home">
    <div class="mobile-nav-icon-box">
      <svg class="mobile-app-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </div>
    <span class="mobile-nav-label mobile-app-nav-label">Home</span>
  </a>

  <a href="{{ pages['products-categories'].url | default: pages['products'].url | default: routes.all_products_collection_url }}" class="mobile-nav-item mobile-app-nav-item {% if request.path contains '/collections' or request.path contains 'product' or request.path contains 'categor' %}active is-active{% endif %}" aria-label="Browse Surgical Catalog">
    <div class="mobile-nav-icon-box">
      <svg class="mobile-app-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
    </div>
    <span class="mobile-nav-label mobile-app-nav-label">Products</span>
  </a>

  <a href="/pages/wholesale-custom-orders" class="mobile-nav-item mobile-app-nav-item b2b-quote-action {% if request.path contains 'wholesale' %}active is-active{% endif %}" aria-label="Request Factory RFQ Quote">
    <div class="mobile-nav-icon-box b2b-action-gem">
      <svg class="mobile-app-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
    </div>
    <span class="mobile-nav-label mobile-app-nav-label">RFQ Quote</span>
  </a>

  <a href="{{ routes.cart_url }}" class="mobile-nav-item mobile-app-nav-item js-cart-trigger" id="mobile-app-cart-btn" aria-label="View Procurement Cart">
    <div class="mobile-nav-icon-box">
      <svg class="mobile-app-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="mobile-nav-badge mobile-app-nav-badge" id="mobile-cart-badge" style="display: none;">0</span>
    </div>
    <span class="mobile-nav-label mobile-app-nav-label">Cart</span>
  </a>

  <a href="{{ routes.account_url }}" class="mobile-nav-item mobile-app-nav-item {% if request.path contains '/account' or request.path contains '/login' or request.path contains '/register' %}active is-active{% endif %}" aria-label="Institutional Account">
    <div class="mobile-nav-icon-box">
      <svg class="mobile-app-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </div>
    <span class="mobile-nav-label mobile-app-nav-label">Account</span>
  </a>
</nav>
{%- endif -%}

{% schema %}
{
  "name": "Mobile Bottom Nav",
  "settings": []
}
{% endschema %}
