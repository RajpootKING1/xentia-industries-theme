<section class="specialties-section" id="specialties">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge-pill">CLINICAL CATEGORIES</span>
      <h2 class="section-title">PRECISION BY SURGICAL SPECIALTY</h2>
      <p class="section-subtitle">
        Calibrated micro-patterns engineered to meet the stringent biomechanical tolerances of leading operating theatres.
      </p>
    </div>

    <div class="specialties-grid">
      <!-- 1. Plastic & Rhinoplasty -->
      <a href="/collections/all?specialty=rhinoplasty" class="specialty-card">
        <div class="specialty-card-img-wrap">
          <img src="{{ 'spec_rhinoplasty.webp' | asset_url }}" alt="Plastic & Rhinoplasty Instruments" loading="lazy" width="400" height="280">
        </div>
        <div class="specialty-card-body">
          <span class="specialty-tag">54-56 HRC | GERMAN DIN 1.4021</span>
          <h3 class="specialty-name">Plastic & Rhinoplasty</h3>
          <p class="specialty-desc">Aufricht & Cottle retractors, osteotomes, cartilage morselizers, and supercut iris dissection scissors.</p>
          <span class="specialty-link-text">Browse 16 Instruments &rarr;</span>
        </div>
      </a>

      <!-- 2. Hair Restoration -->
      <a href="/collections/all?specialty=hair-restoration" class="specialty-card">
        <div class="specialty-card-img-wrap">
          <img src="{{ 'spec_hair_restoration.webp' | asset_url }}" alt="Hair Restoration Instruments" loading="lazy" width="400" height="280">
        </div>
        <div class="specialty-card-body">
          <span class="specialty-tag">58-60 HRC | TITANIUM COATED</span>
          <h3 class="specialty-name">Hair Restoration (FUE / FUT)</h3>
          <p class="specialty-desc">Serrated micro-punches (0.7mm - 1.0mm), angled follicular forceps, and implanter pen assemblies.</p>
          <span class="specialty-link-text">Browse 12 Instruments &rarr;</span>
        </div>
      </a>

      <!-- 3. Dental & Maxillofacial -->
      <a href="/collections/all?specialty=dental" class="specialty-card">
        <div class="specialty-card-img-wrap">
          <img src="{{ 'spec_dental.webp' | asset_url }}" alt="Dental & Maxillofacial Instruments" loading="lazy" width="400" height="280">
        </div>
        <div class="specialty-card-body">
          <span class="specialty-tag">52-55 HRC | ASTM F899</span>
          <h3 class="specialty-name">Dental & Oral Surgery</h3>
          <p class="specialty-desc">Atraumatic extraction forceps, periosteal elevators, bone rongeurs, and sinus lift osteotome kits.</p>
          <span class="specialty-link-text">Browse 14 Instruments &rarr;</span>
        </div>
      </a>

      <!-- 4. Orthopedic & Spine -->
      <a href="/collections/all?specialty=orthopedic" class="specialty-card">
        <div class="specialty-card-img-wrap">
          <img src="{{ 'spec_orthopedic.webp' | asset_url }}" alt="Orthopedic & Spine Instruments" loading="lazy" width="400" height="280">
        </div>
        <div class="specialty-card-body">
          <span class="specialty-tag">56-58 HRC | FORGED STAINLESS</span>
          <h3 class="specialty-name">Orthopedic & Spine Surgery</h3>
          <p class="specialty-desc">Hohmann & Beckman retractor systems, bone holding clamps, Kerrison rongeurs, and mallet assemblies.</p>
          <span class="specialty-link-text">Browse 10 Instruments &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Specialties Explorer",
  "settings": []
}
{% endschema %}
