<article class="standard-page-section">
  <div class="container" style="max-width: 900px; padding: var(--space-16) var(--space-4);">
    <header class="page-header text-center" style="margin-bottom: var(--space-10);">
      <h1 class="page-title" style="font-family: var(--font-heading); font-size: var(--text-4xl); color: var(--color-steel-white); margin-bottom: var(--space-3);">
        {{ page.title }}
      </h1>
      <div style="width: 60px; height: 2px; background: var(--color-gold-base); margin: 0 auto;"></div>
    </header>

    <div class="page-content rte" style="color: var(--color-steel-silver); line-height: 1.8; font-size: var(--text-base);">
      {{ page.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Standard Page",
  "settings": []
}
{% endschema %}
