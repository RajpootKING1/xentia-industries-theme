<!-- Filter Interactivity Script -->
<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      var filterButtons = document.querySelectorAll('.sets-filter-bar .set-filter-pill');
      var cards = document.querySelectorAll('#surgical-sets-grid .surgical-set-card');
      
      if (!filterButtons.length || !cards.length) return;

      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetCat = btn.getAttribute('data-cat');
          
          filterButtons.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');

          cards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            if (targetCat === 'all' || cardCat === targetCat) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  })();
</script>

