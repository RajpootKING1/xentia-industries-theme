<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="{{ shop.name | default: 'Xentia Industries' }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: 'Precision German DIN 1.4021 Surgical Instruments, OEM/ODM Manufacturing, and Wholesale Hospital Procurement from Sialkot, Pakistan.' | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- else -%}
  <meta property="og:image" content="{{ 'hero_surgical_showcase.webp' | asset_url }}">
{%- endif -%}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | default: 'Precision German DIN 1.4021 Surgical Instruments, OEM/ODM Manufacturing, and Wholesale Hospital Procurement from Sialkot, Pakistan.' | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200, height: 630 }}">
{%- else -%}
  <meta name="twitter:image" content="{{ 'hero_surgical_showcase.webp' | asset_url }}">
{%- endif -%}

<!-- Organization & MedicalBusiness JSON-LD Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness", "MedicalBusiness"],
      "@id": "{{ shop.url }}/#organization",
      "name": "Xentia Industries",
      "alternateName": "Xentia Surgical Instruments",
      "url": "{{ shop.url }}",
      "logo": "{{ 'apple-touch-icon.png' | asset_url }}",
      "image": "{{ 'hero_surgical_showcase.webp' | asset_url }}",
      "description": "Premier manufacturer and international exporter of professional surgical, dental, orthopedic, and veterinary instruments in Sialkot, Pakistan.",
      "telephone": "+92 349 7400818",
      "email": "info@xentiaindustries.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Capital Road, Model Town",
        "addressLocality": "Sialkot",
        "addressRegion": "Punjab",
        "postalCode": "51310",
        "addressCountry": "PK"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 32.4945,
        "longitude": 74.5229
      },
      "priceRange": "$$",
      "currenciesAccepted": "USD, EUR, GBP, AED, PKR",
      "paymentAccepted": "Bank Transfer, Telegraphic Transfer (TT), Letter of Credit (LC), Credit Card",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "sameAs": [
        "https://facebook.com/xentiaindustries",
        "https://www.instagram.com/xentia.industries",
        "https://linkedin.com/company/xentiaindustries",
        "https://youtube.com/@xentiaindustries",
        "https://tiktok.com/@xentiaindustries"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "Xentia Industries",
      "description": "Precision Surgical Instruments Crafted for Global Excellence",
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    {%- if request.page_type == 'product' -%}
    ,{
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncatewords: 40 | json }},
      "image": [
        {%- for image in product.images limit: 3 -%}
          "https:{{ image | image_url: width: 800, height: 800 }}"{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "brand": {
        "@type": "Brand",
        "name": "Xentia Industries"
      },
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "seller": {
          "@type": "Organization",
          "name": "Xentia Industries"
        }
      }
    }
    {%- endif -%}
  ]
}
</script>
